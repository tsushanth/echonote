    <string name="consent_title">स्पीच रिकग्निशन बेहतर बनाने में मदद करें</string>
    <string name="consent_intro">स्पीच रिकग्निशन ज़्यादा बोली जाने वाली भाषाओं में सबसे अच्छा काम करता है। आप अपनी चुनी हुई रिकॉर्डिंग साझा करके और भाषाओं के लिए बेहतर मॉडल बनाने में मदद कर सकते हैं।</string>
    <string name="consent_shared_title">क्या साझा किया जाता है</string>
    <string name="consent_shared_body">ऑडियो रिकॉर्डिंग, उसकी ट्रांसक्रिप्ट और उसकी भाषा, केवल उन रिकॉर्डिंग के लिए जिन्हें आप ट्रांसक्राइब करना चुनते हैं।</string>
    <string name="consent_why_title">क्यों</string>
    <string name="consent_why_body">और भाषाओं के लिए स्पीच-रिकग्निशन मॉडल बनाने में मदद करने के लिए, उन भाषाओं सहित जिन्हें आज कम सेवा मिलती है।</string>
    <string name="consent_optional_title">पूरी तरह वैकल्पिक</string>
    <string name="consent_optional_body">यह डिफ़ॉल्ट रूप से बंद है। आप इसे कभी भी सेटिंग में, गोपनीयता सेक्शन के अंतर्गत बंद कर सकते हैं।</string>
