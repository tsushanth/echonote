    <string name="consent_shared_body">The audio recording, its transcript, and the language it\'s in, only for recordings you choose to transcribe.</string>
    <string name="consent_why_title">Why</string>
    <string name="consent_why_body">To help train speech-recognition models for more languages, including ones that are underserved today.</string>
    <string name="consent_optional_title">Fully optional</string>
    <string name="consent_optional_body">This is off by default. You can turn it off anytime in Settings, under the Privacy section.</string>
